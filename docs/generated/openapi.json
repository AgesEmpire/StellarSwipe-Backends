{
  "openapi": "3.0.0",
  "info": {
    "title": "StellarSwipe API",
    "version": "1.0",
    "description": "StellarSwipe backend REST API"
  },
  "paths": {
    "/signals": {
      "get": {
        "tags": ["Signals"],
        "summary": "List signals",
        "operationId": "SignalsController_getSignals",
        "parameters": [],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/soroban/simulate": {
      "post": {
        "tags": ["Soroban"],
        "summary": "Simulate a Soroban contract call",
        "operationId": "SorobanController_simulate",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SimulateContractDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Simulation result (check `success` field)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SimulateContractResponseDto"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "SimulateContractDto": {
        "type": "object",
        "required": ["contractId", "method"],
        "properties": {
          "contractId": { "type": "string" },
          "method": { "type": "string" },
          "params": { "type": "array", "items": {} },
          "sourceAccount": { "type": "string" },
          "sourceSecret": { "type": "string" },
          "timeoutMs": { "type": "number" }
        }
      },
      "SimulateContractResponseDto": {
        "type": "object",
        "required": ["success"],
        "properties": {
          "success": { "type": "boolean" },
          "resourceFee": { "type": "string" },
          "minResourceFee": { "type": "string" },
          "inclusionFee": { "type": "string" },
          "totalFee": { "type": "string" },
          "result": {},
          "footprint": {
            "type": "object",
            "properties": {
              "readOnly": { "type": "array", "items": { "type": "string" } },
              "readWrite": { "type": "array", "items": { "type": "string" } }
            }
          },
          "auth": { "type": "array", "items": { "type": "string" } },
          "simulationError": { "type": "string" },
          "rpcError": { "type": "string" }
        }
      }
    }
  },
  "servers": [
    {
      "url": "http://localhost:3000"
    }
  ],
  "tags": [
    { "name": "Signals" },
    { "name": "Soroban" }
  ]
}
